# Copy to .env (or set these in your host's dashboard) before going live.

# Required in production. Generate with:  openssl rand -hex 32
SESSION_SECRET=

# Tells the app to set Secure cookies and HSTS. Set this on your host.
NODE_ENV=production

# Optional
PORT=3000
# DB_PATH=/var/data/site.db       # put the database on a persistent disk
