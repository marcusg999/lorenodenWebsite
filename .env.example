# Copy to .env (or set these in your host's dashboard) before going live.

# --- required in production ---------------------------------------------
# Generate with:  openssl rand -hex 32
SESSION_SECRET=

# Sets Secure cookies and HSTS, and enforces the mail rules below.
NODE_ENV=production

# The public origin. Reset links are built from this rather than the Host
# header, so an attacker cannot point a reset link at their own server.
APP_URL=https://lorenoden.com

# --- email, for password reset ------------------------------------------
# Plain SMTP, so any provider works. Examples:
#   Resend    smtp.resend.com    587   user: resend     pass: <api key>
#   Postmark  smtp.postmarkapp.com 587 user/pass: <server token>
#   SES       email-smtp.<region>.amazonaws.com 587  <smtp credentials>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Loren Oden" <no-reply@lorenoden.com>

# --- optional -------------------------------------------------------------
PORT=3000
# DB_PATH=/var/data/site.db         # put the database on a persistent disk
# UPLOAD_DIR=/var/data/uploads      # and the uploaded images too
# SMTP_ALLOW_INSECURE=true          # local mail catchers only; ignored in production
