# Copy to .env (or set these in your host's dashboard) before going live.

# --- required in production ---------------------------------------------
# Generate with:  openssl rand -hex 32
SESSION_SECRET=

# Sets Secure cookies and HSTS, and enforces the mail rules below.
NODE_ENV=production

# The public origin. Reset links are built from this rather than the Host
# header, so an attacker cannot point a reset link at their own server.
APP_URL=https://lorenoden.com

# --- email, for password reset ------------------------------------------
# Plain SMTP, so any provider works. Examples:
#   Resend    smtp.resend.com    587   user: resend     pass: <api key>
#   Postmark  smtp.postmarkapp.com 587 user/pass: <server token>
#   SES       email-smtp.<region>.amazonaws.com 587  <smtp credentials>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Loren Oden" <no-reply@lorenoden.com>

# --- publishing: portal edits go live by themselves -----------------------
# On save the portal commits data/content.json (and any images the content
# points at) to this repo. Netlify's normal git deploy rebuilds from it.
# A fine-grained token needs only Contents: read and write on this one repo.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main

# --- database -------------------------------------------------------------
# sqlite    a local file; nothing to set up. The default, for development.
# postgres  Supabase, or any Postgres. Required on a host with no disk.
DB_DRIVER=sqlite

# Supabase → Project Settings → Database → Connection string →
# **Transaction pooler**, port 6543. Not the direct port: a serverless
# function opens and drops connections constantly and would exhaust it.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres
# PGPOOL_MAX=3                      # connections per instance; keep it small
# PGSCHEMA=                         # tables in a named schema; leave unset in production
# PGSSL_CA=                         # the database CA, if the default chain is rejected

# --- image storage ----------------------------------------------------------
# local     a folder on this machine. Needs a persistent disk.
# supabase  a Supabase Storage bucket. Required on Netlify Functions.
STORAGE=local

# SUPABASE_URL=https://<ref>.supabase.co
# Project Settings → API → service_role. It bypasses row-level security, so it
# belongs in the server's environment only — never in the repo or the browser.
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=uploads           # make it public: the images are meant to be seen

# --- optional -------------------------------------------------------------
PORT=3000
# DB_PATH=/var/data/site.db         # sqlite only: put the file on a persistent disk
# UPLOAD_DIR=/var/data/uploads      # local storage only: and the images too
# SMTP_ALLOW_INSECURE=true          # local mail catchers only; ignored in production
